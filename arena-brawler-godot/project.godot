; Godot-4-Projektdatei für Arena Brawler.
;
; Bewusst von Hand geschrieben und knapp gehalten: Godot ergänzt beim ersten
; Öffnen alles Weitere selbst. Was hier steht, ist das, was wirklich gesetzt
; sein muss — jede zusätzliche Zeile wäre eine, die beim nächsten Öffnen
; womöglich überschrieben wird und trotzdem im Diff auftaucht.

config_version=5

[application]

config/name="Arena Brawler"
config/description="2D-Arena-Brawler in Godot 4. Eigenständig, unabhängig von der React-Spielesammlung."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Spielstand="*res://autoload/spielstand.gd"
Charaktere="*res://autoload/charaktere.gd"

[display]

; 1152 x 648 ist 16:9 und damit dasselbe Seitenverhältnis wie das spätere
; Zielgerät im Querformat. `canvas_items` mit `expand` skaliert die Oberfläche
; mit, ohne sie zu verzerren — das Gegenstück zu Scale.FIT im Phaser-Prototyp.
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

